# ============================================================
#  TongKey 后端 —— 生产敏感配置模板（application-secret.yml）
#  使用方法：复制到 APP_HOME 目录并填真实值
#    cp doc/application-secret.yml.example /app/tongkey-backend/application-secret.yml
#    vim /app/tongkey-backend/application-secret.yml
#  deploy.sh 启动时会自动用 SPRING_CONFIG_IMPORT 加载此文件
#  ⚠ 此文件包含真实密码和密钥，严禁提交到 git！
# ============================================================

# ── 端口（可选，默认 8180）───────────────────────────────────
server:
  port: 8180

# ── 生产数据库（必填）───────────────────────────────────────
spring:
  datasource:
    url: jdbc:postgresql://your-prod-db:5432/tongkey
    username: tongkey_app
    password: replace-with-real-password
    hikari:
      maximum-pool-size: 50
  jpa:
    hibernate:
      ddl-auto: validate

# ── TongKey 业务配置 ────────────────────────────────────────
tongkey:
  # AES 加密密钥（必填，用于加密存储敏感字段，32 字符以上随机字符串）
  crypto:
    key: replace-with-a-32-char-random-key

  # 管理员账号（生产必须覆盖密码）
  admin:
    username: admin
    password: replace-with-strong-password
    token-ttl-minutes: 240
