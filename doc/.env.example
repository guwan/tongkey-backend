# ============================================================
#  TongKey 后端部署环境变量模板（.env.example）
#  使用方法：复制为 .env 后填入真实值
#    cp .env.example .env
#    vim .env
#  deploy.sh 会在启动前自动 source APP_HOME/.env
# ============================================================

# ── Spring Boot 运行环境 ──────────────────────────────────────
# 本地开发: SPRING_PROFILES_ACTIVE=dev,local
# 生产部署: SPRING_PROFILES_ACTIVE=prod（推荐同时用外部配置文件覆盖敏感值）
SPRING_PROFILES_ACTIVE=prod

# ── 生产数据库（生产部署必填）──────────────────────────────────
TONGKEY_DB_URL=jdbc:postgresql://your-prod-db:5432/tongkey
TONGKEY_DB_USER=tongkey_app
TONGKEY_DB_PASSWORD=replace-with-real-password

# ── 系统配置 ─────────────────────────────────────────────────
SERVER_PORT=8080

# ── TongKey 业务配置 ─────────────────────────────────────────
# AES 加密密钥（用于加密存储敏感字段，32 字符以上随机字符串）
TONGKEY_CRYPTO_KEY=replace-with-a-32-char-random-key

# 管理员账号（默认 admin，生产必须覆盖密码）
TONGKEY_ADMIN_USER=admin
TONGKEY_ADMIN_PASSWORD=replace-with-strong-password

# 数据库连接池（可选覆盖）
TONGKEY_DB_POOL_SIZE=50
