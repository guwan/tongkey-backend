<?xml version="1.0" encoding="UTF-8"?>
<!--
  TongKey 日志配置：
  - 控制台：INFO+，彩色输出，开发友好
  - 文件：  INFO+（生产），保留 30 天，按天滚动
  - 日志路径：
      优先读系统属性 -Dtongkey.log.path=/var/backend/logs
      其次读环境变量 TONGKEY_LOG_PATH
      都没配则默认 ${user.home}/logs/tongkey
-->
<configuration>

    <property name="LOG_PATH"
              value="${tongkey.log.path:-${TONGKEY_LOG_PATH:-${user.home}/logs/tongkey}}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- ── 控制台（彩色，跟随 Spring Boot 默认）── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── 生产文件（INFO+，按天滚动，30 天保留）── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/tongkey-backend.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/tongkey-backend.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ── 开发文件（DEBUG+，仅 dev profile 启用）── -->
    <appender name="FILE_DEBUG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/tongkey-backend-debug.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/tongkey-backend-debug.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ── 生产 profile（默认）── -->
    <springProfile name="prod">
        <logger name="com.tongkey" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </logger>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>

    <!-- ── dev / local profile ── -->
    <springProfile name="dev">
        <logger name="com.tongkey" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_DEBUG"/>
        </logger>
    </springProfile>
    <springProfile name="local">
        <logger name="com.tongkey" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

    <!-- ── 默认（无 profile 匹配时）── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
